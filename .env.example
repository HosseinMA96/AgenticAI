# FinSight reads the SHARED root .env (../.env). Don't put real values here.
# This file lists only the names FinSight needs.

AZURE_OPENAI_ENDPOINT=   # https://<resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=    # local dev only; the cloud deploy uses managed identity
SEC_USER_AGENT=          # "<app name> <contact email>"; SEC EDGAR blocks requests without it
AZURE_SEARCH_ENDPOINT=   # https://<service>.search.windows.net (Free tier, D17)
AZURE_SEARCH_API_KEY=    # admin key; local dev only, the cloud deploy uses managed identity

# Not used by FinSight: AZURE_OPENAI_DEPLOYMENT / AZURE_OPENAI_API_VERSION
# (model names live in src/finsight/llm.py; see DECISIONS.md D2)
