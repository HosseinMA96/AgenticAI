# Shared Azure config lives in the repo root .env (../.env from here).
# This file documents the keys that file must define — do not put real values here.
AZURE_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Auth is via `az login` + DefaultAzureCredential — no API key needed.
