# Shared Azure config lives in the repo root .env (../.env from here, i.e.
# "Stack of Agents/.env"). This file documents the keys that file must
# define — do not put real values here.
#
# Corrected in Phase 6 to match what the shared .env and every sibling
# Dummy/Pre6/dummy*.py script actually use — this project's CLAUDE.md
# originally assumed az login/DefaultAzureCredential and different var
# names; decided to match the established convention instead (see
# src/llm.py's docstring).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>

# Optional, project-local (not in the shared .env — each sibling script
# hardcodes its own): overrides src/llm.py's default deployment name.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
